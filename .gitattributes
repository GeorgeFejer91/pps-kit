# Browser build inputs and committed outputs must hash identically on Windows and Linux.
apps/designer/frontend/*.css text eol=lf
apps/designer/frontend/*.html text eol=lf
apps/designer/frontend/*.js text eol=lf
apps/designer/frontend/*.json text eol=lf
apps/designer/frontend/*.svg text eol=lf
apps/designer/frontend/**/*.css text eol=lf
apps/designer/frontend/**/*.html text eol=lf
apps/designer/frontend/**/*.js text eol=lf
apps/designer/frontend/**/*.json text eol=lf
apps/designer/frontend/**/*.map text eol=lf
apps/designer/frontend/**/*.svg text eol=lf
apps/designer/frontend/viewer/__init__.py text eol=lf
apps/designer/frontend/compiled/viewer/__init__.py text eol=lf
apps/designer/frontend/viewer/vendor/three/LICENSE text eol=lf
apps/designer/frontend/compiled/viewer/vendor/three/LICENSE text eol=lf
apps/runner/*.js text eol=lf
apps/runner/*.json text eol=lf
apps/runner/**/*.css text eol=lf
apps/runner/**/*.html text eol=lf
apps/runner/**/*.js text eol=lf
apps/runner/**/*.json text eol=lf

# Pages copies these public text inputs directly; keep their bytes portable.
website/.nojekyll text eol=lf
website/CNAME text eol=lf
website/**/*.css text eol=lf
website/**/*.html text eol=lf
website/**/*.js text eol=lf
website/**/*.json text eol=lf
website/**/*.md text eol=lf
website/**/*.svg text eol=lf
website/**/*.txt text eol=lf
packages/pps-resources/study_templates/**/*.json text eol=lf
packages/pps-resources/assets/preloads/**/*.json text eol=lf
packages/pps-resources/assets/preloads/**/*.csv text eol=lf
packages/pps-resources/assets/preloads/**/*.md text eol=lf
packages/pps-resources/assets/preloads/**/*.svg text eol=lf
packages/pps-resources/assets/preloads/**/*.txt text eol=lf
packages/pps-resources/assets/ui/*.mjs text eol=lf

# Reviewed third-party bytes are hash-pinned and must never receive newline conversion.
apps/runner/frontend/public/vendor/vdoninja/1.5.5/* -text whitespace=-trailing-space
apps/runner/compiled/vendor/vdoninja/1.5.5/* -text whitespace=-trailing-space
