{
  "schema": "pps-repository-root-allowlist.v1",
  "tracked_directories": [
    ".github", "For-AI", "apps", "distributions", "docs", "packages", "third_party", "website"
  ],
  "tracked_files": [
    ".gitattributes", ".gitignore", "AGENTS.md", "Cargo.lock", "Cargo.toml", "CITATION.cff", "LICENSE", "pyproject.toml", "README.md",
    "THIRD_PARTY_LICENSES.md"
  ],
  "rule": "Root contains only repository metadata, package metadata, public product trees, and unavoidable GitHub adapters."
}
