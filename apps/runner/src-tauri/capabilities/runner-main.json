{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "runner-main",
  "description": "Core and exact native Runner commands for the bundled main window.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-runner-snapshot",
    "allow-runner-record-response",
    "allow-runner-dispatch",
    "allow-remote-status",
    "allow-configure-remote",
    "allow-rotate-pairing",
    "allow-select-prepared-session",
    "allow-prepare-experiment-profile",
    "allow-inspect-prepared-execution",
    "allow-prepare-current-audio-block",
    "allow-remote-session-claim",
    "allow-remote-session-renew",
    "allow-remote-session-dispatch",
    "allow-remote-session-revoke",
    "allow-native-latency-diagnostics",
    "allow-native-output-status",
    "allow-activate-native-execution",
    "allow-native-output-enumerate",
    "allow-native-output-reserve-silence",
    "allow-native-output-release",
    "allow-native-output-disable"
  ]
}
