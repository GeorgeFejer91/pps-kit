  "provenance": [
    {
      "field": "trajectory_plane_height_m",
      "source": "The MATLAB reference uses only x/y coordinates: ears at [-head_diam/2, 0] and [+head_diam/2, 0], source path [x, ordinate]. There is no vertical coordinate, so the matching 3D convention is z = 0 at the ear/head-center plane."
    },
    {
      "field": "front_offset_y_m",
      "source": "Reference variable `ordinate = 0.05`, described as the distance between the source and the head at 0 degrees."
    },
    {
      "field": "path and speed",
      "source": "Reference variables `start = -0.4`, `stop = -start`, and `speed = 0.2`; movement duration is abs(stop-start)/speed = 4 s."
    },
    {
      "field": "noise",
      "source": "Reference script uses pink noise synthesis via a 1/F filter at 44100 Hz."
    },
    {
      "field": "head_diameter_m",
      "source": "Reference variable `head_diam = 0.18`; the 3DTI listener is created with matching head radius 0.09 m for customized ITD."
    },
    {
      "field": "reference level and gains",
      "source": "Reference variables `ref_dB = 100`, `att_factor = 40`, directional dB loss equations for each ear, and final `output_F = 0.25 * output_F ./ max(max(output_F))`; because of final peak normalization, the WAV is not absolutely SPL calibrated."
    },
    {
      "field": "vestibular condition block labels",
      "source": "Expected-outcome extraction and Consensus MCP abstract sanity check identify congruent audio-vestibular motion, incongruent audio-vestibular motion, and no-rotation comparison context. These labels are carried as block context only; the original passive whole-body rotation apparatus is not a generated audio/tactile waveform."
    }
  ],
  "notes": "This manifest audits recreation inside the PPS Toolkit GUI. It distinguishes toolkit-generated recreations of reported parameters from the original authors' exact stimulus set."
}