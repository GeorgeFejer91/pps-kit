    {
      "field": "app source",
      "source": "DynaSpace source repository at https://forge-2.ircam.fr/roussel/dynaspace/ contains the Android DynaSpaceIrcam app used for the task."
    },
    {
      "field": "SOA anchors and catch code",
      "source": "MainActivity.kt defines timeArray = [105, 1625, 2385, 2765, 2955, 3050, 0], with the zero value used as a no-vibration catch."
    },
    {
      "field": "trial distribution",
      "source": "rand.cpp creates 48 recorded audio-tactile rows across two sound modes, six timing values, and four repeats, plus 24 no-vibration catch rows; five practice rows are prepended."
    },
    {
      "field": "audio assets",
      "source": "The Android raw assets bursttrainlooming.wav and bursttrainfixe.wav are stereo 48 kHz PCM_16 files with 184800 frames, i.e. 3.85 s duration."
    },
    {
      "field": "vibration implementation",
      "source": "WavAudioPlayer.cpp schedules phone vibration after the requested delay plus a 50 ms sleep offset and calls the Android vibrator for 60 ms when the delay is nonzero."
    },
    {
      "field": "toolkit recreation policy",
      "source": "The PPS Toolkit public preload uses generated broadband proxy WAVs through the bundled FABIAN/SOFA renderer and records the original Android WAVs as non-redistributed provenance."
    }
  ],
  "notes": "This manifest audits recreation inside the PPS Toolkit GUI. It distinguishes toolkit-generated recreations of reported parameters from the original authors' exact stimulus set."
