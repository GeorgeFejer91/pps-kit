    {
      "field": "instruction assets",
      "source": "Bundled owned Study 5 breathing instruction WAVs include both assets/breathing/british_kokoro generated with Kokoro ONNX using the British English bf_emma voice and assets/breathing/original_study5 decoded from the original local Study 5 instruction MP3s. The default Study 5 preload now uses the original Study 5 inhale/exhale clips, while the British Kokoro pair remains available as an alternate fixed-audio source."
    },
    {
      "field": "prebaked looming assets",
      "source": "Bundled owned Study 5 auditory-only looming WAVs under assets/preloads/study5_box_breathing_pps/02_looming_stimuli; the preload inventory records the original generated-noise recipe, trajectory metadata, segment catalog paths, and SHA-256 hashes."
    },
    {
      "field": "visible trial assembly",
      "source": "Local Study 5 dashboard workflow uses within-block trial type rows: Inhale instruction | Looming Stimulus and Exhale instruction | Looming Stimulus. Rows are logged as trial_type_label values and scheduled sequentially top-to-bottom inside each block."
    },
    {
      "field": "trajectory and SOAs",
      "source": "Study 5 toolkit defaults: 110 cm to 10 cm approach, 3 s movement inside a 4 s stimulus window, SOAs 300/800/1500/2200/2700 ms."
    }
