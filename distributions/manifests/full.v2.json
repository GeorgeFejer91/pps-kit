{
  "schema": "pps-component-manifest.v2",
  "component_id": "full",
  "version": "0.1.0",
  "platform": "windows-x64",
  "dependencies": [
    {"component_id": "shared", "version": "0.1.0"},
    {"component_id": "planner", "version": "0.1.0"},
    {"component_id": "runner", "version": "0.1.0"}
  ],
  "source_to_install": [],
  "entrypoints": [
    {"id": "pps-experiment-planner", "path": "pps-experiment-planner.exe", "shortcut": "PPS Experiment Planner"},
    {"id": "pps-experiment-runner", "path": "runner/pps-experiment-runner.exe", "shortcut": "PPS Experiment Runner"}
  ],
  "composition": {"shared_copies": 1, "central_hub": false},
  "exclusions": ["For-AI/**", "**/participant_data/**", "**/generated_outputs/**", "**/*.apk"]
}
