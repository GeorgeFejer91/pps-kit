  "provenance": [
    {
      "field": "study scope",
      "source": "Experimental Brain Research article reports PPS measured with an audio-tactile interaction task before and after using a 1 m tool."
    },
    {
      "field": "task scaffold",
      "source": "The 2013 article says procedures were similar to Canzoneri et al. (2012); the profile inherits the 2012 dynamic-sound count, baseline, catch, and block contract."
    },
    {
      "field": "SOA and catch values",
      "source": "2013 Methods report T1-T5 at 300, 800, 1500, 2200, and 2700 ms from sound onset, with tactile targets in 60% of trials and auditory-only catches in 40%."
    },
    {
      "field": "expected outcome",
      "source": "2013 Results/Figure 3 report a post-tool-use shift of the fitted PPS central point toward far space; Experiment 3 pointing control reports no comparable shift."
    }
  ],
