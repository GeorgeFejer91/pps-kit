    },
    {
      "field": "trial_formula",
      "source": "Methods report 2 Locomotion x 2 Sound Direction x (5 Distances + 2 Baselines + 1 Catch) x 16 = 512 trials."
    },
    {
      "field": "expected_outcome",
      "source": "Results report standing near-body facilitation around D1-D2 and walking facilitation through D5/166 cm, with receding sounds not showing the same spatial modulation."
