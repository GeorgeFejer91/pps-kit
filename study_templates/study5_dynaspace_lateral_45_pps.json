    "trajectory_balance_policy": "Two source-level trajectory snapshots encode left -45 degrees and right +45 degrees. Segment 4 repetitions preserve equal left/right counts across audio-tactile, stationary-burst baseline, and catch families.",
    "baseline_policy": "The smartphone fixed 640 cm comparator is mapped onto the Study 5 Segment 3 stationary_burst baseline family: each looming source is replaced by a fixed DynaSpace-style burst train at the same left/right 45-degree start anchor while tactile timing remains matched to the six DynaSpace anchors.",
    "source_asset_equivalence": "trajectory, condition logic, 33-burst temporal structure, and approximate 95 ms burst spacing are matched; exact Android noise seed, Spat/LISTEN renderer, room response, phone transducer response, and motor mechanics are not bit-matched",
    "stimulus_generation_operating_protocol": {
      "schema": "pps-dynaspace-consensus-generation-v1",
      "decision": "Adopt the DynaSpace/Hobeika burst-train dry source as the smartphone-profile source profile while delegating spatialization to the 3DTI/SOFA renderer.",
      "evidence_basis": [
        "Raw DynaSpace WAV audit detected 33 bursts with about 95 ms median inter-onset interval.",
        "Hobeika lineage reports Gaussian white-noise bursts with 30 ms duration, 10 ms rise/fall, and 65 ms inter-burst interval.",
        "Consensus searches supported broadband onset transients for localization/salience and supported HRTF/ILD/ITD/reverb/near-field cues as renderer-level spatial properties.",
        "Consensus searches warned that rising intensity alone can produce looming salience, so matched-level controls remain necessary for causal inference."
      ],
      "dry_source_profile": "dynaspace_gaussian_burst_train",
      "spatialization_policy": "Render HRTF, ILD, ITD, near-field, distance attenuation, future trajectory angle, and optional room/DRR/IACC cues through 3DTI/SOFA rather than hard-coding them into the dry source.",
      "control_policy": "Keep the DynaSpace replication contrast available, and add matched-level control variants for inference-focused future studies."
    },
